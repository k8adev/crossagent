---
import type { Lang } from '../i18n';
import { LOCALES, t } from '../i18n';
import GithubIcon from './GithubIcon.astro';
import { getStars } from '../lib/stars';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang);

/* SSR-only star count, memoized per process in lib/stars.ts. A failed or slow call renders 0. */
const stars = await getStars();
---

<header class="topbar">
  <div class="topbar__inner">
    <a class="topbar__mark" href="#pair">crossagent</a>

    <div class="topbar__right">
      <nav class="topbar__lang-switch" aria-label={copy.header.langSwitchAriaLabel}>
        {LOCALES.map((locale) => (
          <a
            class={`topbar__lang${lang === locale.code ? ' topbar__lang--current' : ''}`}
            href={locale.path}
            aria-current={lang === locale.code ? 'page' : undefined}
          >{locale.label}</a>
        ))}
      </nav>

      <a
        class="topbar__star"
        href="https://github.com/k8adev/crossagent"
        target="_blank"
        rel="noopener"
        aria-label={copy.header.starAriaLabel(stars)}
      >
        <GithubIcon size={16} />
        <span class="topbar__star-count">{(stars ?? 0).toLocaleString('en-US')}</span>
      </a>
    </div>
  </div>
</header>
