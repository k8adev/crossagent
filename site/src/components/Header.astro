---
import type { Lang } from '../i18n';
import { LOCALES, t } from '../i18n';
import GithubIcon from './GithubIcon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang);

const STAR_CACHE_TTL_MS = 5 * 60 * 1000;

/* Module scope: survives across requests in the same SSR process, so renders within the TTL
   skip the GitHub API call entirely. Cache-Control on the response (Base.astro) only caches
   the HTML at the CDN — it does not stop this fetch on a cache miss there. */
let cache: { stars: number | null; at: number } = { stars: null, at: 0 };

async function fetchStars(): Promise<number | null> {
  /* Optional server-side token: lets the count resolve while the repo is still private. */
  const token = import.meta.env.GITHUB_TOKEN;

  try {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 2000);

    try {
      const response = await fetch('https://api.github.com/repos/k8adev/crossagent', {
        headers: {
          Accept: 'application/vnd.github+json',
          ...(token ? { Authorization: `Bearer ${token}` } : {}),
        },
        signal: controller.signal,
      });

      if (response.ok) {
        const repo = await response.json();
        if (typeof repo?.stargazers_count === 'number') {
          return repo.stargazers_count;
        }
      }
    } finally {
      clearTimeout(timeout);
    }
  } catch {
    return null;
  }
  return null;
}

/* SSR-only star count: a failed or slow call degrades to a bare "Star". */
if (Date.now() - cache.at > STAR_CACHE_TTL_MS) {
  cache = { stars: await fetchStars(), at: Date.now() };
}
const stars = cache.stars;
---

<header class="topbar">
  <div class="topbar__inner">
    <a class="topbar__mark" href="#pair">crossagent</a>

    <div class="topbar__right">
      <nav class="topbar__lang-switch" aria-label={copy.header.langSwitchAriaLabel}>
        {LOCALES.map((locale) => (
          <a
            class={`topbar__lang${lang === locale.code ? ' topbar__lang--current' : ''}`}
            href={locale.path}
            aria-current={lang === locale.code ? 'page' : undefined}
          >{locale.label}</a>
        ))}
      </nav>

      <a
        class="topbar__star"
        href="https://github.com/k8adev/crossagent"
        target="_blank"
        rel="noopener"
        aria-label={copy.header.starAriaLabel(stars)}
      >
        <GithubIcon size={16} />
        <span class="topbar__star-count">{(stars ?? 0).toLocaleString('en-US')}</span>
      </a>
    </div>
  </div>
</header>
